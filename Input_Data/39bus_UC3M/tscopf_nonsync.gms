Variables
    Pg(g)
    Qg(g)
    Ig(g)
    phi(g)
    V(b,s)
    alpha(b,s)
    ed_p(g,s)
    eq_p(g,s)
    id(g,s)
    iq(g,s)
    e_fd(g)
    delta(g,s)
    Domega(g,s)
    Pe(g,s)
    delta_COI(s)
    speed_COI(s)
    lv_correc(b,s)
    con(b)
    v_sup(b)
    wcurtail(b)
    wcurtailgen
   
    z;

    Pg.l(g) = 0;
    Qg.l(g) = 0;
    Ig.l(g) = 1; Ig.lo(g) = 0.001; Ig.up(g) = Pmax(g)*1.4;
    phi.l(g) = 0; phi.lo(g) = -pi/2; phi.up(g) = pi/2;
    V.l(b,s) = 1; V.lo(b,'1') = 0.992; V.up(b,'1') = 1.1;
    alpha.l(b,s) = 0; alpha.lo(b,'1') = -pi; alpha.up(b,'1') = pi;
    ed_p.l(g,s) = 0; ed_p.lo(g,s) = 0; ed_p.up(g,s) = 2.5;
    eq_p.l(g,s) = 1; eq_p.lo(g,s) = 0; eq_p.up(g,s) = 2.5;
    id.l(g,s) = 1; id.lo(g,s) = -Pmax(g)*1.4; id.up(g,s) = 3*Pmax(g)*1.4;
    iq.l(g,s) = 1; iq.lo(g,s) = -Pmax(g)*1.4; iq.up(g,s) = 3*Pmax(g)*1.4;
    e_fd.l(g) = 1;
    delta.l(g,s)= 0; delta.lo(g,s) = -9999; delta.up(g,s) = 9999;
    Domega.l(g,s) = 0; Domega.lo(g,s) = -9999.9; Domega.up(g,s) = 9999.9;
    Pe.l(g,s) = 0; Pe.lo(g,s) = -9999; Pe.up(g,s) = 9999;
    delta_COI.l(s) = 0; delta_COI.lo(s) = -9999; delta_COI.up(s) = 9999;
    speed_COI.l(s) = 0; speed_COI.lo(s) = -9999; speed_COI.up(s) = 9999;
    delta_COI.l(s) = 0;
    speed_COI.l(s) = 0;
    wcurtail.l(b) = 1.0; wcurtail.lo(b) = 0.0; wcurtail.up(b) = 1.0;
    wcurtailgen.l = 1.0; wcurtailgen.lo = 0.0; wcurtailgen.up = 1.0;

    Equations
    total_cost

    p_balance_gen_initialization
    p_balance_gen_fault
    p_balance_gen_postfault
    p_balance_nongen_initialization
    p_balance_nongen_fault
    p_balance_nongen_postfault
    q_balance_gen_initialization
    q_balance_gen_fault
    q_balance_gen_postfault
    q_balance_nongen_initialization
    q_balance_nongen_fault
    q_balance_nongen_postfault
    ref_bus
    low_voltage_correction
    wind_farm_wf1_disconnection
    wind_farm_wf2_disconnection
    wind_farm_non_wf_disconnection
    wind_farm_v_support
    wind_farm_non_v_support
    wcurtailgeneral

    P_gen_lim_inf
    P_gen_lim_sup
    Q_gen_lim_inf
    Q_gen_lim_sup

    Generators_current
    Power_factor

    e_fd_lim_inf
    e_fd_lim_sup

    ed_p_ini
    eq_p_ini
    Domega_ini
    P_ini
    Q_ini

    Internal_voltaje_p
    Internal_voltaje_q
    oscilation_omega
    oscilation_delta

    electric_power
    Vd_time
    Vq_time

    center_of_inertia
    center_of_inertia_speed
    angular_deviation_min
    angular_deviation_max
    speed_deviation_min
    speed_deviation_max;

* Objetive function
    total_cost .. z =e= sum(g,cost_a(g)+Pg(g)*Sb*cost_b(g)+Pg(g)*Pg(g)*Sb*Sb*cost_c(g));

* Power Flow equations
**Active power flow generators
        p_balance_gen_initialization(g) ..  Pg(g) + lv_correc(g,'1')*Pw(g)*wcurtail(g) - Pl(g)*(Al(g)+Bl(g)*V(g,'1')+Cl(g)*V(g,'1')*V(g,'1')) - V(g,'1')*sum(b,V(b,'1')*Y(g,b)*cos(alpha(g,'1') - alpha(b,'1') - theta(g,b))) =e= 0;
        p_balance_gen_fault(g,sf) ..  V(g,sf)*id(g,sf)*sin(delta(g,sf) - alpha(g,sf)) + V(g,sf)*iq(g,sf)*cos(delta(g,sf) - alpha(g,sf)) + con(g)*lv_correc(g,sf)*Pw(g)*wcurtail(g) - Pl(g)*(Al(g)+Bl(g)*V(g,sf)+Cl(g)*sqr(V(g,sf))) - V(g,sf)*sum(b,V(b,sf)*Y_f(g,b)*cos(alpha(g,sf) - alpha(b,sf) - theta_f(g,b))) =e= 0;
        p_balance_gen_postfault(g,spf) .. V(g,spf)*id(g,spf)*sin(delta(g,spf) - alpha(g,spf)) + V(g,spf)*iq(g,spf)*cos(delta(g,spf) - alpha(g,spf)) + con(g)*lv_correc(g,spf)*Pw(g)*wcurtail(g) - Pl(g)*(Al(g)+Bl(g)*V(g,spf)+Cl(g)*sqr(V(g,spf))) - V(g,spf)*sum(b,V(b,spf)*Y_pf(g,b)*cos(alpha(g,spf) - alpha(b,spf) - theta_pf(g,b))) =e= 0;

**Active power flow non-generators
        p_balance_nongen_initialization(ngb) .. lv_correc(ngb,'1')*Pw(ngb)*wcurtail(ngb) - Pl(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,'1')+Cl(ngb)*V(ngb,'1')*V(ngb,'1')) - V(ngb,'1')*sum(b,V(b,'1')*Y(ngb,b)*cos(alpha(ngb,'1') - alpha(b,'1') - theta(ngb,b))) =e= 0;
        p_balance_nongen_fault(ngb,sf) .. con(ngb)*lv_correc(ngb,sf)*Pw(ngb)*wcurtail(ngb) - Pl(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,sf)+Cl(ngb)*sqr(V(ngb,sf))) - V(ngb,sf)*sum(b,V(b,sf)*Y_f(ngb,b)*cos(alpha(ngb,sf) - alpha(b,sf) - theta_f(ngb,b))) =e= 0;
        p_balance_nongen_postfault(ngb,spf) .. con(ngb)*lv_correc(ngb,spf)*Pw(ngb)*wcurtail(ngb) - Pl(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,spf)+Cl(ngb)*sqr(V(ngb,spf))) - V(ngb,spf)*sum(b,V(b,spf)*Y_pf(ngb,b)*cos(alpha(ngb,spf) - alpha(b,spf) - theta_pf(ngb,b))) =e= 0;

**Reactive power flow generators
        q_balance_gen_initialization(g) .. windfarm(g)*v_sup(g)*V(g,'1')*min(0.9,0.9/0.5*(1.0-V(g,'1'))) + Qg(g) - Ql(g)*(Al(g)+Bl(g)*V(g,'1')+Cl(g)*sqr(V(g,'1'))) - V(g,'1')*sum(b,V(b,'1')*Y(g,b)*sin(alpha(g,'1') - alpha(b,'1') - theta(g,b))) =e= 0;
        q_balance_gen_fault(g,sf) ..   windfarm(g)*v_sup(g)*con(g)*V(g,sf)*min(0.9,0.9/0.5*(1.0-V(g,sf))) + V(g,sf)*id(g,sf)*cos(delta(g,sf) - alpha(g,sf)) - V(g,sf)*iq(g,sf)*sin(delta(g,sf) - alpha(g,sf)) - Ql(g)*(Al(g)+Bl(g)*V(g,sf)+Cl(g)*sqr(V(g,sf))) - V(g,sf)*sum(b,V(b,sf)*Y_f(g,b)*sin(alpha(g,sf) - alpha(b,sf) - theta_f(g,b))) =e= 0;
        q_balance_gen_postfault(g,spf) .. windfarm(g)*v_sup(g)*con(g)*V(g,spf)*min(0.9,0.9/0.5*(1.0-V(g,spf))) + V(g,spf)*id(g,spf)*cos(delta(g,spf) - alpha(g,spf)) - V(g,spf)*iq(g,spf)*sin(delta(g,spf) - alpha(g,spf)) - Ql(g)*(Al(g)+Bl(g)*V(g,spf)+Cl(g)*sqr(V(g,spf))) - V(g,spf)*sum(b,V(b,spf)*Y_pf(g,b)*sin(alpha(g,spf) - alpha(b,spf) - theta_pf(g,b))) =e= 0;

**Reactive power flow non-generators
        q_balance_nongen_initialization(ngb) ..  windfarm(ngb)*v_sup(ngb)*V(ngb,'1')*min(0.9,0.9/0.5*(1.0-V(ngb,'1'))) - Ql(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,'1')+Cl(ngb)*sqr(V(ngb,'1'))) - V(ngb,'1')*sum(b,V(b,'1')*Y(ngb,b)*sin(alpha(ngb,'1') - alpha(b,'1') - theta(ngb,b))) =e= 0;
        q_balance_nongen_fault(ngb,sf) .. windfarm(ngb)*v_sup(ngb)*con(ngb)*V(ngb,sf)*min(0.9,0.9/0.5*(1.0-V(ngb,sf))) - Ql(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,sf)+Cl(ngb)*sqr(V(ngb,sf))) - V(ngb,sf)*sum(b,V(b,sf)*Y_f(ngb,b)*sin(alpha(ngb,sf) - alpha(b,sf) - theta_f(ngb,b))) =e= 0;
        q_balance_nongen_postfault(ngb,spf) .. windfarm(ngb)*v_sup(ngb)*con(ngb)*V(ngb,spf)*min(0.9,0.9/0.5*(1.0-V(ngb,spf))) - Ql(ngb)*(Al(ngb)+Bl(ngb)*V(ngb,spf)+Cl(ngb)*sqr(V(ngb,spf))) - V(ngb,spf)*sum(b,V(b,spf)*Y_pf(ngb,b)*sin(alpha(ngb,spf) - alpha(b,spf) - theta_pf(ngb,b))) =e= 0;

    low_voltage_correction(b,s) .. lv_correc(b,s) - min(1.0,V(b,s)*V(b,s)/0.2/0.2) =e= 0;
    wind_farm_wf1_disconnection(wf1) .. con(wf1) =e= V(wf1,'2') ge 0.85;
    wind_farm_wf2_disconnection(wf2) .. con(wf2) =e= V(wf2,'2') ge 0.2;
    wind_farm_non_wf_disconnection(b)$(not wf(b)) .. con(b)$(not wf(b)) =e= 1.0;
    wind_farm_v_support(wf2) .. v_sup(wf2) =e= 1.0;
    wind_farm_non_v_support(b)$(not wf2(b)) .. v_sup(b)$(not wf2(b)) =e= 0.0;
    wcurtailgeneral(b) .. wcurtail(b) =e= wcurtailgen;

    ref_bus .. alpha('1','1') =e= 0;

* Generators limits
    P_gen_lim_inf(g) .. Pmin(g) =l= Pg(g);
    P_gen_lim_sup(g) .. Pg(g) =l= Pmax(g);
    Q_gen_lim_inf(g) .. Qmin(g) =l= Qg(g);
    Q_gen_lim_sup(g) .. Qg(g) =l= Qmax(g);

* Initial condition equations
    ed_p_ini(g) .. ed_p(g,'1') - (Xq(g) - Xq_p(g))*iq(g,'1') =e= 0;
    eq_p_ini(g) .. eq_p(g,'1') + (Xd(g) - Xd_p(g))*id(g,'1') - e_fd(g) =e= 0;
    Domega_ini(g).. Domega(g,'1') =e= 0;
    P_ini(g) .. Pg(g) - V(g,'1')*sin(delta(g,'1') - alpha(g,'1'))*id(g,'1') - V(g,'1')*cos(delta(g,'1') - alpha(g,'1'))*iq(g,'1') =e= 0;
    Q_ini(g) .. Qg(g) - V(g,'1')*cos(delta(g,'1') - alpha(g,'1'))*id(g,'1') + V(g,'1')*sin(delta(g,'1') - alpha(g,'1'))*iq(g,'1') =e= 0;

* Limits of variables
    e_fd_lim_inf(g) .. e_fd_min(g) =l= e_fd(g);
    e_fd_lim_sup(g) .. e_fd(g) =l= e_fd_max(g);

* Discretized equations
    Internal_voltaje_p(g,s)$(not sfirst(s)) .. ed_p(g,s)*(1 + Dt/(2*Tq_p(g))) - ed_p(g,s-1)*(1 - Dt/(2*Tq_p(g))) - (Dt/(2*Tq_p(g)))*(Xq(g) - Xq_p(g))*(iq(g,s) + iq(g,s-1)) =e= 0;
    Internal_voltaje_q(g,s)$(not sfirst(s)) .. eq_p(g,s)*(1 + Dt/(2*Td_p(g))) - eq_p(g,s-1)*(1 - Dt/(2*Td_p(g))) - (Dt/(2*Td_p(g)))*(2*e_fd(g) - (Xd(g) - Xd_p(g))*(id(g,s) + id(g,s-1))) =e= 0;
    oscilation_omega(g,s)$(not sfirst(s)) .. Domega(g,s)*(1 + Dt*D(g)/(4*H(g))) - Domega(g,s-1)*(1 - Dt*D(g)/(4*H(g))) - (Dt/(4*H(g)))*(2*(Pg(g)) - Pe(g,s) - Pe(g,s-1)) =e= 0;
    oscilation_delta(g,s)$(not sfirst(s)) .. delta(g,s) - delta(g,s-1) - (Dt*100*pi/2)*(Domega(g,s) + Domega(g,s-1)) =e= 0;

*   Machine electrical power equations
    electric_power(g,s) .. Pe(g,s) - ed_p(g,s)*id(g,s) - eq_p(g,s)*iq(g,s) =e= 0;

    Vd_time(g,s) .. V(g,s)*sin(delta(g,s) - alpha(g,s)) - ed_p(g,s) + Ra(g)*id(g,s) -  Xq_p(g)*iq(g,s) =e= 0;
    Vq_time(g,s) .. V(g,s)*cos(delta(g,s) - alpha(g,s)) - eq_p(g,s) + Ra(g)*iq(g,s) +  Xd_p(g)*id(g,s) =e= 0;


*   Stability criterion equations
    center_of_inertia(s) .. delta_COI(s) - sum(g,H(g)*delta(g,s)) / sum(g,H(g)) =e= 0;
    center_of_inertia_speed(s) .. speed_COI(s) - sum(g,H(g)*Domega(g,s)) / sum(g,H(g)) =e= 0;
    angular_deviation_min(g,s) .. - (angle_limit*pi/180) =l= delta(g,s) - delta_COI(s);
    angular_deviation_max(g,s) .. delta(g,s) - delta_COI(s) =l= (angle_limit*pi/180);
    speed_deviation_min(g,s) .. -0.02 =l= Domega(g,s) - speed_COI(s);
    speed_deviation_max(g,s) .. Domega(g,s) - speed_COI(s) =l= 0.02;

Model tscopf /total_cost, 
p_balance_gen_initialization, 
p_balance_gen_fault, 
p_balance_gen_postfault, 
p_balance_nongen_initialization, 
p_balance_nongen_fault, 
p_balance_nongen_postfault, 
q_balance_gen_initialization, 
q_balance_gen_fault,
q_balance_gen_postfault,
q_balance_nongen_initialization, 
q_balance_nongen_fault, 
q_balance_nongen_postfault,
low_voltage_correction,
wind_farm_wf1_disconnection,
wind_farm_wf2_disconnection,
wind_farm_non_wf_disconnection,
wind_farm_v_support,
wind_farm_non_v_support,
*wcurtailgeneral,
ref_bus,
P_gen_lim_inf, P_gen_lim_sup, Q_gen_lim_inf, Q_gen_lim_sup,
e_fd_lim_inf, e_fd_lim_sup,
ed_p_ini,
eq_p_ini,
Domega_ini,
P_ini,
q_ini,
Internal_voltaje_p, Internal_voltaje_q, oscilation_omega, oscilation_delta,
electric_power,
Vd_time, Vq_time,
center_of_inertia,
center_of_inertia_speed,
angular_deviation_min, angular_deviation_max,
speed_deviation_min, 
speed_deviation_max,
/;
*Model tscopf /all/;

Option NLP = IPOPT;
Option DNLP = IPOPT;
Option RMIP = IPOPT;
Option Reslim = 4000;
Solve tscopf using DNLP minimizing z;

Display Pg.l
Display Qg.l
Display V.l
Display alpha.l

Display delta.l

